{
  "name": "kmitl-x",
  "description": "Transform KMITL Student Information System UI/UX with enhanced features for a better experience.",
  "version": "2.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:opera": "wxt build -b opera",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:opera": "wxt zip -b opera",
    "check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BossNz/kmitl-x.git"
  },
  "devDependencies": {
    "@iconify/svelte": "^3.1.6",
    "@tsconfig/svelte": "5.0.4",
    "@types/chrome": "0.0.279",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.46.4",
    "svelte-check": "^4.0.5",
    "tslib": "2.8.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@xpd/tailwind-3dtransforms": "^1.0.3",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "postcss": "^8.4.47",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.14"
  }
}
